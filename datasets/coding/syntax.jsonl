{"language": "python", "concept": "loop", "syntax": "for item in collection:", "example": "for item in items:\n    print(item)", "explanation": "Iterates through values."}
{"language": "python", "concept": "class", "syntax": "class Name:", "example": "class Player:\n    def __init__(self, name):\n        self.name = name", "explanation": "Defines a Python class."}
{"language": "javascript", "concept": "function", "syntax": "function name(parameters) {}", "example": "function greet(name) {\n  return `Hello ${name}`;\n}", "explanation": "Defines a JavaScript function."}
